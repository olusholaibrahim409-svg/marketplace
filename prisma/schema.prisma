generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Address {
  id                   String      @id
  userId               String
  phone                String
  addressLine1         String
  addressLine2        String?
  city                 String
  state                String
  country              String      @default("Nigeria")
  postalCode           String?
  isDefault            Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime
  firstName            String
  lastName             String
  addressType          AddressType @default(HOME)
  deliveryInstructions String?
  User                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Order                Order[]

  @@index([isDefault])
  @@index([userId])
  @@index([userId, isDefault])
}

model Brand {
  id          String    @id
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Product     Product[]

  @@index([name])
}

model Cart {
  id        String     @id
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]
}

model CartItem {
  id             String          @id
  cartId         String
  productId      String
  quantity       Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  variantId      String?
  Cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product        Product         @relation(fields: [productId], references: [id])
  ProductVariant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Category {
  id             String     @id
  name           String
  slug           String     @unique
  description    String?
  imageUrl       String?
  parentId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Product        Product[]

  @@index([name])
  @@index([parentId])
}

model Commission {
  id        String   @id
  sellerId  String
  rate      Decimal
  amount    Decimal
  createdAt DateTime @default(now())
  orderId   String   @unique
  Order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Seller    Seller   @relation(fields: [sellerId], references: [id])

  @@index([createdAt])
  @@index([sellerId])
}

model Coupon {
  id              String       @id
  code            String       @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal
  maximumDiscount Decimal?
  usageLimit      Int?
  status          CouponStatus @default(ACTIVE)
  startsAt        DateTime
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  minimumAmount   Decimal?
  usedCount       Int          @default(0)

  @@index([expiresAt])
  @@index([startsAt])
  @@index([status])
}

model FlashSale {
  id               String             @id
  name             String
  description      String?
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  FlashSaleProduct FlashSaleProduct[]

  @@index([endsAt])
  @@index([isActive])
  @@index([startsAt])
}

model FlashSaleProduct {
  id           String    @id
  flashSaleId  String
  productId    String
  salePrice    Decimal
  stockLimit   Int?
  soldQuantity Int       @default(0)
  FlashSale    FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  Product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
  @@index([productId])
}

model Inventory {
  id        String   @id
  productId String   @unique
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  User      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
}

model Order {
  id            String          @id
  orderNumber   String          @unique
  userId        String
  addressId     String
  status        OrderStatus     @default(PENDING)
  subtotal      Decimal
  shippingFee   Decimal         @default(0)
  discount      Decimal         @default(0)
  total         Decimal
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  sellerId      String?
  Commission    Commission?
  Address       Address         @relation(fields: [addressId], references: [id])
  Seller        Seller?         @relation(fields: [sellerId], references: [id])
  User          User            @relation(fields: [userId], references: [id])
  OrderItem     OrderItem[]
  Payment       Payment?
  ReturnRequest ReturnRequest[]
  Shipment      Shipment?

  @@index([addressId])
  @@index([createdAt])
  @@index([sellerId])
  @@index([status])
  @@index([userId])
}

model OrderItem {
  id             String          @id
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPrice      Decimal
  totalPrice     Decimal
  createdAt      DateTime        @default(now())
  variantId      String?
  Order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product        Product         @relation(fields: [productId], references: [id])
  ProductVariant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id        String        @id
  orderId   String        @unique
  reference String        @unique
  amount    Decimal
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime
  provider  String?
  Order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([method])
  @@index([status])
}

model Payout {
  id        String        @id
  sellerId  String
  amount    Decimal
  reference String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime
  paidAt    DateTime?
  status    PaymentStatus  @default(PENDING)
  Seller    Seller         @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
}

model Product {
  id               String             @id
  sellerId         String
  categoryId       String
  brandId          String?
  name             String
  slug             String             @unique
  description      String?
  sku              String?            @unique
  price            Decimal
  compareAtPrice   Decimal?
  status           ProductStatus      @default(PENDING)
  isFeatured       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  isFlashSale      Boolean            @default(false)
  stockQuantity    Int                @default(0)
  CartItem         CartItem[]
  FlashSaleProduct FlashSaleProduct[]
  Inventory        Inventory?
  OrderItem        OrderItem[]
  Brand            Brand?             @relation(fields: [brandId], references: [id])
  Category         Category           @relation(fields: [categoryId], references: [id])
  Seller           Seller             @relation(fields: [sellerId], references: [id])
  ProductImage     ProductImage[]
  ProductVariant   ProductVariant[]
  Review           Review[]
  WishlistItem     WishlistItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([isFlashSale])
  @@index([sellerId])
  @@index([status])
}

model ProductImage {
  id        String   @id
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String      @id
  productId     String
  name          String
  sku           String?     @unique
  price         Decimal?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  attributes    Json?
  stockQuantity Int         @default(0)
  CartItem      CartItem[]
  OrderItem     OrderItem[]
  Product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Refund {
  id            String        @id
  amount        Decimal
  reference     String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  returnId      String        @unique
  status        PaymentStatus @default(PENDING)
  ReturnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ReturnRequest {
  id           String       @id
  userId       String
  orderId      String
  reason       String
  description  String?
  status       ReturnStatus @default(REQUESTED)
  updatedAt    DateTime
  createdAt    DateTime     @default(now())
  refundAmount Decimal?
  Refund       Refund?
  Order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([userId])
}

model Review {
  id        String       @id
  userId    String
  productId String
  rating    Int
  title     String?
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime
  Product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  User      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
  @@index([status])
}

model Seller {
  id             String       @id
  userId         String       @unique
  storeName      String
  slug           String       @unique
  description    String?
  logoUrl        String?
  phone          String?
  status         SellerStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approvedAt     DateTime?
  commissionRate Decimal      @default(10)
  Commission     Commission[]
  Order          Order[]
  Payout         Payout[]
  Product        Product[]
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([storeName])
}

model SellerApplication {
  id                   String       @id
  userId               String

  // Personal information
  firstName            String?
  lastName             String?
  email                String?
  phone                String

  // Store information
  storeName            String
  storeDescription     String?
  category             String?
  productsToSell       String?

  // Business information
  businessType         String?
  businessAddress      String?
  city                 String?
  state                String?
  businessRegistration String?

  // Verification information
  identityType         String?
  identityNumber       String?

  // Banking information
  bankName             String?
  accountName          String?
  accountNumber        String?

  // Existing application fields
  businessName         String?
  status               SellerStatus @default(PENDING)
  documents            Json?
  rejectionReason      String?

  createdAt            DateTime     @default(now())
  updatedAt            DateTime

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model Shipment {
  id              String         @id
  orderId         String         @unique
  trackingNumber  String?        @unique
  courier         String?
  status          ShipmentStatus @default(PENDING)
  shippingAddress Json
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  Order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([courier])
  @@index([status])
}

model User {
  id            String          @id
  email         String          @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  phone         String?
  role          UserRole        @default(CUSTOMER)
  status        UserStatus      @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  imageUrl      String?
  Address       Address[]
  Cart          Cart?
  Notification  Notification[]
  Order         Order[]
  ReturnRequest ReturnRequest[]
  Review        Review[]
  Seller        Seller?
  Wishlist      Wishlist?

  @@index([email])
  @@index([role])
  @@index([status])
}

model Wishlist {
  id           String         @id
  userId       String         @unique
  createdAt    DateTime       @default(now())
  User         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  WishlistItem WishlistItem[]
}

model WishlistItem {
  id         String   @id
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  Product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  Wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
  @@index([wishlistId])
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ORDER
  PAYMENT
  PROMOTION
  SYSTEM
  SELLER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  USSD
  CARD
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  COMPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}